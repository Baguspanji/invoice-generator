# Contoh env deploy Docker. Salin menjadi .env lalu sesuaikan:
#   cp .env.docker.example .env
#
# MySQL DISEDIAKAN stack lain via network eksternal "database_net"
# dengan hostname "mysql" (lihat docker-compose.yml).

APP_NAME=IceSum
APP_ENV=production
APP_DEBUG=false
APP_URL=https://invoice.domainanda.com

# Generate sekali, mis. via: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Port host untuk web (http://server:APP_PORT)
APP_PORT=8080

# --- Database (host mysql dipaksa di docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=e_invoice
DB_USERNAME=icesum
DB_PASSWORD=ubah-password-ini

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Token statis opsional untuk endpoint MCP (Authorization: Bearer <token>).
# Kosongkan = endpoint MCP tetap memakai tabel mcp_tokens (Kelola via Pengaturan).
MCP_API_TOKEN=
